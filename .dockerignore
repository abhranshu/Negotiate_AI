# ── VCS ───────────────────────────────────────────────────────────────
.git
.gitignore

# ── Local Python environments (must NEVER be copied into the image) ──
venv/
.venv/
env/
*.egg-info/

# ── Python caches & build artifacts ──────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Local DB & secrets ────────────────────────────────────────────────
*.db
*.sqlite3
!data/chroma/*.sqlite3
.env
.env.local

# ── Local notebooks / scratch ────────────────────────────────────────
*.ipynb

# ── Heavy training/unused data that must stay out of the image ───────
# Keep-away: 2.2GB CDIP invoice image dataset is NOT needed at runtime
data/chainyo___rvl-cdip-invoice/
output/
# Large checkpoints / intermediate training artifacts
*.pt
*.ckpt
*.bin
models/*.bin

# Heavy local-only dirs that must NOT be sent as build context
# (the image only needs api/, AIML/, models/, data/legal, data/chroma)
frontend/
Kotlin/
uploads/
test_uploads/
data/samples/
research_Paper/
scripts/
tests/
docs/
output/

# Logs, scratch files, local DBs — never in the image
*.log
*.txt
!requirements_deploy.txt
cv_out.txt
design.html
fix.md
status.md
WORKDONE.md
RAG.md
FINE_TUNE.md
DATA_SOURCES.md
BUILD_PROMPT.md
CHANGES_AND_SETUP_GUIDE.md
