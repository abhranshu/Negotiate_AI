# NegotiateAI - VM deployment env
# Copy this to /etc/negotiateai/.env on the Ubuntu box and set the real values.
# Do not paste real secrets back into chat or into the repo.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres
# Or for local SQLite on the VM:
# DATABASE_URL=sqlite:///var/lib/negotiateai/negotiateai.db

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=<generate-a-long-random-string>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── LLM / negotiation ────────────────────────────────────────────────────────
USE_EXTERNAL_LLM=false
GROQ_API_KEY=

USE_LOCAL_MODEL=false
LOCAL_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
LOCAL_MODEL_QUANTIZE=true

# ── Voice / ASR (no Groq required anymore) ──────────────────────────────────
USE_LOCAL_ASR=false

# ── Server / process sizing for the low-resource VM ─────────────────────────
UVICORN_WORKERS=1
DEBUG=false
PROXY_COUNT=0
ALLOWED_ORIGINS=["*"]
HOST=0.0.0.0
PORT=8000

# ── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=/var/lib/negotiateai/uploads
MAX_FILE_SIZE_MB=20
UPLOAD_PRUNE_AGE_DAYS=0

# ── Local state paths (systemd service uses these) ──────────────────────────
# Where the app keeps its SQLite DB (if you use SQLite) and uploads.
NEGOTIATEAI_HOME=/var/lib/negotiateai
