[TEMPLATE]
# ── NegotiateAI environment template ─────────────────────────────────────────
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# NEVER commit real .env values to git.

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev (default, no credentials needed):
DATABASE_URL=sqlite:///./phase2_demo.db
# Production (Supabase / Neon / Railway Postgres):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/dbname

# ── Supabase (optional) ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ── LLM ──────────────────────────────────────────────────────────────────────
# External LLM API (e.g. Groq) — not required for this deploy.
USE_EXTERNAL_LLM=false
GROQ_API_KEY=

# Local HF model for negotiation. Keep false on the low-resource VM so the
# API uses the fast rule-based mediator and does not load heavy ML libs.
USE_LOCAL_MODEL=false
LOCAL_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
LOCAL_MODEL_QUANTIZE=true

# ── Voice / ASR ──────────────────────────────────────────────────────────────
# This project does NOT call Groq for voice anymore.
#
# USE_LOCAL_ASR=false  -> voice endpoint runs in demo/stub mode (no transcription,
#                         but uploads are still accepted and case fields can be
#                         filled manually). This is the safe default for the VM.
#
# USE_LOCAL_ASR=true   -> tries a tiny local ASR model (faster-whisper or
#                         openai-whisper). Only enable if you install one of
#                         those and accept the RAM/disk cost. Keep the model
#                         small (tiny) on this hardware.
USE_LOCAL_ASR=false

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# ── Process sizing (low-resource VM) ────────────────────────────────────────
# Keep this at 1 on the 7.6 GB box; raise only if you add more RAM and workers.
UVICORN_WORKERS=1
# Keep false on the VM so we do not load extra debug middleware/logging.
DEBUG=false

# ── Server bind (change if you put a reverse proxy in front) ─────────────────
HOST=0.0.0.0
PORT=8000
