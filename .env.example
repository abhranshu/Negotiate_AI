# ── NegotiateAI environment template ─────────────────────────────────────────
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# NEVER commit real .env values to git.

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev (default, no credentials needed):
DATABASE_URL=sqlite:///./phase2_demo.db
# Production (Supabase / Neon / Railway Postgres):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/dbname

# ── Supabase (optional) ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ── LLM ──────────────────────────────────────────────────────────────────────
USE_EXTERNAL_LLM=false
# Use a local model instead of the fast rule-based fallback. Default is a small
# instruct model (Qwen2.5-3B-Instruct) that runs reasonably fast on CPU;
# set LOCAL_MODEL_ID=bharatgenai/LegalParam for the original 11GB legal model
# (needs ~11GB RAM + transformers<5).
USE_LOCAL_MODEL=false
LOCAL_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
# int8-dynamic-quantize on CPU for ~2-3x faster inference (~60% less memory).
LOCAL_MODEL_QUANTIZE=true
# Get a key from https://console.groq.com
GROQ_API_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
